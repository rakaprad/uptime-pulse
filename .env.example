# Copy to .env and fill in. Never commit the real .env.
# Referenced from config.yaml as ${VAR_NAME}. Leave empty to disable a notifier.

# Telegram: create a bot with @BotFather, then get the chat id of your group/user.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Grafana admin password used by deploy/docker-compose.yml
GF_ADMIN_PASSWORD=change-me
